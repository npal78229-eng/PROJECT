# Copy this file to .env and fill in your real values. Never commit the real .env file.

SECRET_KEY=change-this-to-a-long-random-string
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# DB_ENGINE=mysql  -> use MySQL (submission/production — matches your synopsis)
# DB_ENGINE=sqlite -> quick local testing with zero DB setup
DB_ENGINE=mysql
DB_NAME=exam_system_db
DB_USER=root
DB_PASSWORD=your_mysql_password
DB_HOST=127.0.0.1
DB_PORT=3306
